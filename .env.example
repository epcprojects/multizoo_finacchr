# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real credentials.

PORT=3000
FRONTEND_APP_URL=http://localhost:4200

# Local PostgreSQL — dedicated to Multizoo, separate from any other project's database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=multizoo_app
DB_PASSWORD=
DB_DATABASE=multizoo_dev

# Generate a real random secret for this — do not use this placeholder.
JWT_SECRET=change-me-to-a-long-random-string

# Invite / password-reset emails. Leave blank in local dev — the EmailService
# logs the email content to the console instead of sending when no key is set.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional — the one-time bootstrap super-admin account created by `npx nx run api:seed`.
# Leave both blank in dev: email defaults to superadmin@multizoo.local and a
# random password is generated and printed once to the console. In a
# production environment SUPER_ADMIN_PASSWORD is required — the seed refuses
# to auto-generate one there.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
